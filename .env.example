# A-D PROJECT 환경변수 예시 (.env.local 로 복사해 사용)

# 데이터 폴더(SQLite DB·업로드·백업). 기본값: ./data
AD_DATA_DIR=./data

# 최초 실행 시 생성되는 데모 계정 공통 초기 비밀번호 (DB가 비어 있을 때만 적용)
# 기본값은 src/lib/server/seed.ts 의 DEMO_PASSWORD 참고 — 운영 전 반드시 변경
AD_DEMO_PASSWORD=

# 로그인 화면의 데모 계정 안내 표시 (운영: 0)
AD_SHOW_DEMO_ACCOUNTS=1

# HTTPS 없이 내부망에서 production 실행 시에만 1 (보안 쿠키 비활성화 — 권장하지 않음)
AD_INSECURE_COOKIE=0
